@base_url = http://localhost:7070/api

### Get all movies
GET {{base_url}}/movies

### Get a movie by ID
GET {{base_url}}/movies/{{movie_id}}

### Get all screenings for movie by ID
GET {{base_url}}/movies/{{movie_id}}/screenings

### Get screening by ID
GET {{base_url}}/screenings/{{screening_id}}

### Lock seat for screening
POST {{base_url}}/screenings/{{screening_id}}/seats/{{seat_id}}/lock

### Reserved previously locked seat for screening
POST {{base_url}}/screenings/{{screening_id}}/seats/{{seat_id}}/reserve